ARG VERSION

FROM $VERSION

ENV TERM=xterm
ENV DEBIAN_FRONTEND=noninteractive

# The images carry a root account with a throwaway password and no sudo rules,
# so the test inventory escalates with su
ENV ANSIBLE_BECOME_METHOD=su

RUN apt-get update && apt-get install -y \
  systemd \
  ansible \
  curl \
  bash \
  python3 \
  python3-pip \
  python3-distro \
  unzip \
  && mkdir -p /home/user \
  && echo "user:x:1001:1001:user:/home/user:/bin/bash" >> /etc/passwd \
  && echo "user:x:1001:" >> /etc/group \
  && chown -R user /home/user

RUN echo 'root:toor123' | chpasswd

USER user

COPY . /home/user

WORKDIR /home/user

ENTRYPOINT ["python3", "/home/user/test/container/run-test.py"]
