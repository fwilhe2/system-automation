ARG VERSION

FROM $VERSION

ENV TERM=xterm

# This image grants the test user passwordless sudo below, which is the
# escalation that works here
ENV ANSIBLE_BECOME_METHOD=sudo

RUN pacman -Sy && pacman --noconfirm -S git ansible curl unzip bash sudo \
  && mkdir -p /home/user && echo "user:x:1001:1001:user:/home/user:/bin/bash" >> /etc/passwd \
  && chown -R user /home/user \
  && echo 'user ALL=(ALL:ALL) NOPASSWD:ALL' >> /etc/sudoers

COPY . /home/user

RUN echo 'root:toor123' | chpasswd
RUN echo 'user:toor123' | chpasswd

USER user
WORKDIR /home/user

# Arch has no desktop_packages entry, so only the headless half is applied and
# the assertions in run-test.py are not run here
ENTRYPOINT ["ansible-playbook", "--inventory", "test/container/inventory.yml", "playbooks/common.yml"]
