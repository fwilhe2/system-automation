{# What start-tor-browser.desktop --register-app would write, minus its #}
{# self-modifying shell wrapper: the install path is known up front. #}
[Desktop Entry]
Version=1.0
Name=Tor Browser
GenericName=Web Browser
Comment=Browse the Web anonymously through the Tor network
Exec={{ tor_browser_dir.path }}/Browser/start-tor-browser --detach %u
Icon={{ tor_browser_dir.path }}/Browser/browser/chrome/icons/default/default128.png
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=Tor Browser
Categories=Network;WebBrowser;Security;
Keywords=web;browser;internet;tor;privacy;
